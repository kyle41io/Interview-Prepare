supabase/seed/cron_gmail.local.sql

# Local-only working notes: specs, plans, deploy runbooks and the AWS setup
# checklist, which holds real keys while bootstrapping. Kept on disk, never
# pushed (covers the former docs/SETUP.md entry).
docs/

# Learning content authoring sources — served from private S3, never committed.
# Anchored to repo root: an unanchored "content/" also matches
# services/content/src/content/, the NestJS module that serves this content,
# silently blocking it from git add.
/content/

# Terraform working dirs and generated zips, at any stack depth.
**/.terraform/
**/.build/
*.tfstate
*.tfstate.*

# esbuild output, per service.
**/dist/
**/dist-lambda/
