{
  "name": "interview-prep-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "bundle": "nest build && node esbuild.config.mjs",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "backfill": "ts-node scripts/backfill.ts",
    "backfill-billing": "ts-node scripts/backfill-billing.ts",
    "backfill-inbox": "ts-node scripts/backfill-inbox.ts",
    "create-table": "ts-node scripts/create-table.ts",
    "create-billing-table": "ts-node scripts/create-billing-table.ts",
    "create-chat-table": "ts-node scripts/create-chat-table.ts",
    "create-inbox-table": "ts-node scripts/create-inbox-table.ts",
    "content:push": "node scripts/content-push.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/client-ssm": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@codegenie/serverless-express": "^4.1.6",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^4.15.9",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "pg": "^8.13.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "mjs"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ],
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": [
            "babel-preset-current-node-syntax"
          ],
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "testEnvironment": "node"
  }
}
