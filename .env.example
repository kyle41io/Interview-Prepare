# ============================================================
#  Interview Prep — server secrets template
#  Copy this file to  .env  and fill in real values.
#  .env is gitignored — NEVER commit real secrets.
#  Load into Supabase:  supabase secrets set --env-file ./.env
#  (Public frontend config lives in assets/js/config.js, NOT here.)
# ============================================================

# --- Supabase (Dashboard → Project Settings → API) ---
SERVICE_ROLE_KEY=

# --- Admin (your auth UUID; Dashboard → Authentication → Users) ---
# Already wired into assets/js/config.js for UI-gating; still needed as a secret.
ADMIN_UIDS=

# --- AI provider (pick ONE) ---
# anthropic (default, cheap tier claude-haiku-4-5)  OR  openai (gpt-4o-mini)
AI_PROVIDER=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_CHAT_MODEL=            # optional override, e.g. claude-haiku-4-5 / gpt-4o-mini

# --- Google OAuth (reused for login + Gmail readonly) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail cron scan gate (any random string; e.g. openssl rand -hex 24) ---
CRON_SECRET=

# ============================================================
#  Local service dev (npm run start:dev in any services/* dir)
#  Was api/.env.example, which retired with the monolith. One .env at the
#  repo root serves all five services; only DDB_TABLE and PORT differ, so
#  override those per shell rather than here.
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Per service: ip_progress | ip_billing | ip_chat | ip_inbox.
# content has no table — it reads bundles from S3 (CONTENT_BUCKET).
DDB_TABLE=ip_progress
# Set to http://localhost:8001 to talk to docker-compose.dev.yml's DynamoDB Local.
DDB_ENDPOINT=
CONTENT_BUCKET=
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=https://kyle41io.github.io,http://localhost:8000
# progress 3001, billing 3002, chat 3003, content 3004, inbox 3005.
PORT=3001
# Only needed by the one-time backfill scripts, never by a running service.
SUPABASE_DB_URL=
